<?xml version="1.0" encoding="utf-8"?>
    <!-- hetha LinearLayout horizontal racine,-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#b3ebf2"
    android:orientation="horizontal"
    android:padding="12dp"
    android:textAlignment="center"
    android:weightSum="1">

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.3"
        android:background="@drawable/edittext_border"
        android:scaleType="fitCenter"
        app:srcCompat="@drawable/baseline_person_24" />

    <!-- sta3mlt relativelayout bsh najjm nathem feha les elts wella les vues par rapport l b3athhom
    bl les id mte7om fl partie 0.7 ml écran-->
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.7"
        android:paddingStart="16dp">


        <!--android:layout_below="@id/titre2" bsh lektiba tji ta7t titre l kbir-->
        <TextView
            android:id="@+id/titre2"
            android:layout_width="255dp"
            android:layout_height="42dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/titres"
            android:text="PASSEPORT TEMPOREL"
            android:textAlignment="center"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/titre2"
            android:layout_marginTop="18dp"
            android:text="Nom :"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/textView3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textView2"
            android:layout_marginTop="10dp"
            android:text="Age temporel :"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/textView4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/textView3"
            android:layout_marginTop="10dp"
            android:text="Motif :"
            android:textSize="20sp" />

        <Button
            android:id="@+id/button2"
            android:layout_width="246dp"
            android:layout_height="53dp"
            android:layout_below="@+id/textView4"
            android:layout_marginTop="374dp"
            android:backgroundTint="#2563EB"
            android:text="Approuvez le saut temporel" />

        <Button
            android:id="@+id/button3"
            android:layout_width="246dp"
            android:layout_height="53dp"
            android:layout_below="@+id/textView4"
            android:layout_marginTop="437dp"
            android:backgroundTint="#2563EB"
            android:text="Refuser ( Risque de paradox )" />


    </RelativeLayout>


</LinearLayout>