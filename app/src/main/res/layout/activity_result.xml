<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layout_result_xx"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/message"
        android:layout_width="270dp"
        android:layout_height="120dp"
        android:gravity="center"
        android:text="Verdict"
        android:textColor="#2563EB"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="50dp"
        android:layout_marginLeft="35dp" />

    <!-- sta3mlt AppCompatButton bsh android ma yofrothesh alia thème mta3ou w nwali najjm nthaher eli sta3mltou ml drawble -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_voyageur"
        android:layout_width="320dp"
        android:layout_height="54dp"
        android:layout_marginTop="32dp"
        android:layout_marginLeft="10dp"
        android:text="Nouveau voyageur"
        android:textColor="#000000"
        android:textSize="20sp"
        android:background="@drawable/bordure_btn_nouv_voyageur"/>

</LinearLayout>