<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="20dp"
    android:id="@+id/main">

    <TextView
        android:id="@+id/titre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:text="TIME TRAVEL CUSTOMS"
        android:textAlignment="center"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/sousTitre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="30dp"
        android:text="BUREAU DE CONTRÔLE TEMPOREL"
        android:textAlignment="center" />


    <TextView
        android:id="@+id/textView6"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginBottom="15dp"
        android:text="Identité du voyageur"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textView7"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Nom complet"
        android:textColor="#4E2626"
        android:textSize="16sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/Nom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/edittext_border"
        android:ems="10"
        android:hint="Entrez votre nom..."
        android:inputType="text" />

    <TextView
        android:id="@+id/textView8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Année de naissance"
        android:textSize="16sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/Naiss"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/edittext_border"
        android:ems="10"
        android:hint="Exemple : 1990"
        android:inputType="number"
        android:maxLength="4"/>
    <!-- android:background="@drawable/edittext_border"  star hetheya pour appliquer la bordure 3la ey element -->

    <TextView
        android:id="@+id/textView9"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Année de destination"
        android:textSize="16sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/Dest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="@drawable/edittext_border"
        android:ems="10"
        android:hint="Exemple : 2050"
        android:inputType="number"
        android:maxLength="4"/>

    <TextView
        android:id="@+id/textView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Motif du voyage"
        android:textSize="16sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinner"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_spinner"
        android:paddingStart="12dp"
        android:paddingEnd="40dp"
        android:spinnerMode="dropdown"
        android:entries="@array/motifs_voyage"/>

    <Button
        android:id="@+id/button"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="50dp"
        android:backgroundTint="#2563EB"
        android:text="Inspecter le profile"
        android:textSize="20sp"
        />

</LinearLayout>